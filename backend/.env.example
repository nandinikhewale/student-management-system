# MongoDB connection string (Atlas or local). Include the database name, e.g. /studentDB
MONGODB_URI=mongodb://mongo:27017/studentDB

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=https://student-management-system-frontend-nu-navy.vercel.app,http://localhost:5500,http://127.0.0.1:5500

# Secret path segment for the MCP server at /mcp/<MCP_SECRET> (leave empty to disable)
MCP_SECRET=change-me

PORT=5000
